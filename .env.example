NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional base URL fallback for email confirmation redirects.
# Use your deployed app URL when deploying to Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry values are supplied by the Vercel Sentry integration in Preview/Production.
# Keep the auth token server-side; never prefix it with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# Server-only secrets. Never expose these in browser code.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
